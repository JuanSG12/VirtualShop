rules_version = '2';

// Reglas de Firebase Storage para Tramas.
// Pegar en: Firebase Console > Storage > Reglas > Publicar.
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos de productos: cualquier usuario con sesión las ve; sube quien tenga sesión (imágenes de hasta 3 MB).
    match /products/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto de perfil / logo: solo su dueño escribe.
    match /users/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
