<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Formas -->
    <style name="ShapeAppearance.Tramas.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <style name="ShapeAppearance.Tramas.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Tramas.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.Tramas.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.Tramas.RoundedTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.Tramas.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Tipografía -->
    <style name="TextAppearance.Tramas.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Tramas.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Tramas.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Tramas.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="TextAppearance.Tramas.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
    </style>
    <style name="TextAppearance.Tramas.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="TextAppearance.Tramas.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Botones -->
    <style name="Widget.Tramas.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>
    <style name="Widget.Tramas.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
    <style name="Widget.Tramas.Button.Accent" parent="Widget.Tramas.Button">
        <item name="backgroundTint">@color/ochre</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Widget.Tramas.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/danger</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Widget.Tramas.Button.Small" parent="Widget.Tramas.Button">
        <item name="android:minHeight">38dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Tramas.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Campos de texto -->
    <style name="Widget.Tramas.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxBackgroundMode">outline</item>
    </style>
    <style name="Widget.Tramas.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- Tarjetas, chips, barras -->
    <style name="Widget.Tramas.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    <style name="Widget.Tramas.Card.Soft" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
    </style>
    <style name="Widget.Tramas.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">18dp</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
    </style>
    <style name="Widget.Tramas.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.Tramas.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Tramas.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    <style name="Widget.Tramas.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Opción de pago (RadioButton con aspecto de tarjeta seleccionable) -->
    <style name="Tramas.PayOption" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_selectable_option</item>
        <item name="android:padding">14dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">?attr/colorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.Tramas.Body</item>
        <item name="buttonTint">?attr/colorPrimary</item>
    </style>

    <!-- Etiquetas de estado -->
    <style name="Tramas.Badge" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>
</resources>
