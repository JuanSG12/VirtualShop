<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" app:startDestination="@id/homeFragment">
    <fragment android:id="@+id/homeFragment" android:name="com.tramas.app.ui.buyer.HomeFragment" android:label="@string/tramas">
    </fragment>
    <fragment android:id="@+id/catalogFragment" android:name="com.tramas.app.ui.buyer.CatalogFragment" android:label="@string/catalogo">
        <argument android:name="category" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>
    <fragment android:id="@+id/productDetailFragment" android:name="com.tramas.app.ui.buyer.ProductDetailFragment" android:label="@string/detalle_del_producto">
        <argument android:name="productId" app:argType="integer" android:defaultValue="0"  />
    </fragment>
    <fragment android:id="@+id/cartFragment" android:name="com.tramas.app.ui.buyer.CartFragment" android:label="@string/mi_carrito">
    </fragment>
    <fragment android:id="@+id/checkoutFragment" android:name="com.tramas.app.ui.buyer.CheckoutFragment" android:label="@string/pasarela_de_pagos">
    </fragment>
    <fragment android:id="@+id/buyerOrdersFragment" android:name="com.tramas.app.ui.buyer.BuyerOrdersFragment" android:label="@string/mis_pedidos">
    </fragment>
    <fragment android:id="@+id/buyerProfileFragment" android:name="com.tramas.app.ui.buyer.BuyerProfileFragment" android:label="@string/mi_perfil">
    </fragment>
</navigation>
